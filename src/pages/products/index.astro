---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Products — Dating Photo Lab"
  description="Ideas, prompts, and practical systems for making photos feel less staged."
>
  <main class="products-page">
    <section class="products-page-intro">
      <p class="eyebrow">PRODUCTS</p>

      <h1>Better ideas for photos that still feel like you.</h1>

      <p>
  Ideas, prompts, and practical systems for making photos feel less staged.
</p>
    </section>

    <section class="products-page-list">
      <a
        class="product-page-item"
        href="/products/stop-looking-awkward-in-photos/"
      >
        <span class="product-number">01</span>

        <div>
          <h2>Stop Looking Awkward In Photos</h2>
          <p>Free guide</p>
        </div>

        <span class="product-arrow">→</span>
      </a>

      <a class="product-page-item" href="/products/50-natural-dating-photo-ideas/">
        <span class="product-number">02</span>

        <div>
          <h2>50 Natural Dating Photo Ideas</h2>
          <p>$5</p>
        </div>

        <span class="product-arrow">→</span>
      </a>

      <a class="product-page-item" href="/products/ai-dating-photo-system/">
        <span class="product-number">03</span>

        <div>
          <h2>AI Dating Photo System</h2>
          <p>$14.99</p>
        </div>

        <span class="product-arrow">→</span>
      </a>
    </section>
  </main>
</BaseLayout>