---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Stop Looking Awkward In Photos"
  description="10 effortless prompts for women who freeze when a camera appears."
>
  <main>
    <section class="product-hero">
      <div class="product-hero-copy reveal">
        <p class="eyebrow">FREE GUIDE</p>

        <h1>Stop Looking Awkward In Photos</h1>

        <p class="product-intro">
          10 effortless prompts for women who freeze when a camera appears.
        </p>

        <a
          class="button"
          href="https://payhip.com/b/ktRaS"
          target="_blank"
          rel="noopener noreferrer"
        >
          Get the free guide
        </a>
      </div>

      <div class="product-hero-product reveal reveal-delay">
        <img
          src="/products/stop-looking-awkward/cover.png"
          alt="Cover of Stop Looking Awkward In Photos free guide"
        />
      </div>
    </section>

    <section class="product-introduction reveal-on-scroll">
      <div class="product-introduction-copy">
        <p class="eyebrow">THE IDEA</p>

        <h2>You don't need to know how to pose.</h2>

        <p>
          Most people don't hate photos because of how they look. They hate the
          feeling of being watched while trying to look natural.
        </p>

        <p>
          This guide takes a different approach. Instead of giving you another
          list of poses, it gives you simple things to do while the camera is
          there.
        </p>
      </div>
    </section>

    <section class="product-shift">
      <div class="product-shift-copy reveal-on-scroll">
        <p class="eyebrow">ONE SMALL SHIFT</p>

        <h2>Stop trying to look natural. Start doing something.</h2>

        <p>
          When you have something simple to do, you have less to think about.
          Your hands have a purpose, your attention has somewhere to go, and the
          moment can start to feel less like a photo being taken.
        </p>
      </div>

      <figure class="product-shift-illustration reveal-on-scroll">
        <img
          src="/products/stop-looking-awkward/stop-looking-awkward-before-after-doodle.png"
          alt="A loose pencil doodle showing the difference between feeling awkward in front of a camera and having something natural to do"
          loading="lazy"
        />
      </figure>
    </section>

    <section class="product-scenes">
      <div class="product-scenes-heading reveal-on-scroll">
        <p class="eyebrow">WHAT'S INSIDE</p>

        <h2>Five simple situations from the guide.</h2>

        <p>
          The full guide contains 10 prompts built around ordinary things you
          can actually do while someone is taking your photo.
        </p>
      </div>

      <div class="scene scene-featured reveal-on-scroll">
        <img
          src="/products/stop-looking-awkward/coffee-shop-01.jpg"
          alt="Woman reading a menu in a coffee shop"
          loading="lazy"
        />

        <p>01 — The Coffee Shop Prompt</p>
      </div>

      <div class="scene-grid">
        <div class="scene reveal-on-scroll">
          <img
            src="/products/stop-looking-awkward/choosing-flowers.jpg"
            alt="Woman choosing flowers at a flower shop"
            loading="lazy"
          />

          <p>02 — The Flowers Prompt</p>
        </div>

        <div class="scene reveal-on-scroll">
          <img
            src="/products/stop-looking-awkward/walking.jpg"
            alt="Woman walking along a town street"
            loading="lazy"
          />

          <p>03 — The Walking Prompt</p>
        </div>

        <div class="scene reveal-on-scroll">
          <img
            src="/products/stop-looking-awkward/packing-a-bag.jpg"
            alt="Woman packing a bag at home"
            loading="lazy"
          />

          <p>04 — The Preparation Prompt</p>
        </div>

        <div class="scene reveal-on-scroll">
          <img
            src="/products/stop-looking-awkward/bookstore.jpg"
            alt="Woman looking through a book in a bookstore"
            loading="lazy"
          />

          <p>05 — The Book Prompt</p>
        </div>
      </div>
    </section>

    <section class="product-closing reveal-on-scroll">
      <p class="eyebrow">READY TO TRY IT?</p>

      <h2>Give yourself something to do.</h2>

      <a
        class="button"
        href="https://payhip.com/b/ktRaS"
        target="_blank"
        rel="noopener noreferrer"
      >
        Get the free guide
      </a>
    </section>
  </main>
</BaseLayout>

<script>
  const revealItems = document.querySelectorAll(".reveal-on-scroll");

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }, 180);
          }
        });
      },
      {
        threshold: 0.28,
      },
    );

    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  }
</script>

<style>
  .product-hero {
    width: min(100% - 48px, var(--container));
    min-height: 720px;
    margin: 0 auto;
    padding: 120px 0 100px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    align-items: center;
    gap: clamp(60px, 10vw, 140px);
  }

  .product-hero-copy {
    max-width: 720px;
  }

  .product-hero-copy h1 {
    margin: 0;
    max-width: 700px;
    font-size: clamp(52px, 7vw, 88px);
    line-height: 0.98;
    font-weight: 500;
    letter-spacing: -0.055em;
  }

  .product-intro {
    max-width: 580px;
    margin: 32px 0 0;
    font-size: 20px;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .product-hero .button {
    margin-top: 32px;
  }

  .product-hero-product {
    width: 320px;
    justify-self: end;
  }

  .product-hero-product img {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 0 24px 60px rgba(36, 36, 36, 0.12);
  }

  .product-introduction {
    width: min(100% - 48px, var(--container));
    margin: 0 auto;
    padding: 120px 0 140px;
    border-top: 1px solid rgba(36, 36, 36, 0.12);
  }

  .product-introduction-copy {
    max-width: 680px;
  }

  .product-introduction h2,
  .product-shift h2,
  .product-scenes-heading h2,
  .product-closing h2 {
    margin: 0;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  .product-introduction p:not(.eyebrow),
  .product-shift p:not(.eyebrow),
  .product-scenes-heading p:not(.eyebrow) {
    max-width: 620px;
    margin: 28px 0 0;
    font-size: 19px;
    line-height: 1.7;
  }

  .product-shift {
    width: min(100% - 48px, var(--container));
    margin: 0 auto;
    padding: 150px 0 190px;
    display: grid;
    grid-template-columns: minmax(0, 680px) minmax(220px, 360px);
    align-items: center;
    justify-content: space-between;
    gap: 64px;
  }

  .product-shift-copy {
    max-width: 680px;
  }

  .product-shift-illustration {
    width: min(100%, 340px);
    margin: 0;
    justify-self: end;
  }

  .product-shift-illustration img {
    display: block;
    width: 100%;
    height: auto;
  }

  .product-scenes {
    width: min(100% - 48px, var(--container));
    margin: 0 auto;
    padding: 0 0 160px;
  }

  .product-scenes-heading {
    max-width: 700px;
    margin-bottom: 72px;
  }

  .scene {
    margin: 0;
  }

  .scene img {
    display: block;
    width: 100%;
    height: auto;
  }

  .scene p {
    margin: 14px 0 0;
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-muted);
  }

  .scene-featured {
    max-width: 600px;
    margin: 0 auto 64px;
  }

  .scene-grid {
    width: min(100%, 600px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 24px;
  }

  .scene-grid .scene:nth-child(1) {
    transition-delay: 0s;
  }

  .scene-grid .scene:nth-child(2) {
    transition-delay: 0.12s;
  }

  .scene-grid .scene:nth-child(3) {
    transition-delay: 0.06s;
  }

  .scene-grid .scene:nth-child(4) {
    transition-delay: 0.18s;
  }

  .reveal {
    opacity: 0;
    transform: translateY(32px);
    animation: product-reveal 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .reveal-delay {
    animation-delay: 0.4s;
  }

  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 1.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes product-reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .reveal-on-scroll {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 800px) {
    .product-hero {
      min-height: auto;
      padding: 80px 0 100px;
      grid-template-columns: 1fr;
      gap: 64px;
    }

    .product-hero-product {
      width: min(100%, 360px);
      justify-self: start;
    }

    .product-introduction,
    .product-shift {
      padding: 90px 0 110px;
    }

    .product-scenes {
      padding-bottom: 110px;
    }

    .scene-featured {
      margin-bottom: 56px;
    }

    .scene-grid {
      gap: 56px 20px;
    }

    .product-closing {
      padding: 90px 0 120px;
    }

    .product-shift {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .product-shift-illustration {
      justify-self: start;
      width: min(100%, 300px);
    }
  }

  @media (max-width: 560px) {
    .product-hero,
    .product-introduction,
    .product-shift,
    .product-scenes,
    .product-closing {
      width: min(100% - 32px, var(--container));
    }

    .product-hero {
      padding-top: 56px;
    }

    .product-hero-copy h1 {
      font-size: clamp(46px, 14vw, 64px);
    }

    .product-intro {
      font-size: 18px;
    }

    .product-introduction h2,
    .product-shift h2,
    .product-scenes-heading h2,
    .product-closing h2 {
      font-size: clamp(32px, 10vw, 44px);
    }

    .product-introduction p:not(.eyebrow),
    .product-shift p:not(.eyebrow),
    .product-scenes-heading p:not(.eyebrow) {
      font-size: 18px;
      line-height: 1.65;
    }

    .scene-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
