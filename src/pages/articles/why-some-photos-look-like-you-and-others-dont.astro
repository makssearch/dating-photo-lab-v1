        }

        .article-content {
            padding: 56px 0 100px;
        }

        .article-content p {
            font-size: 17px;
            line-height: 1.7;
        }

        .article-content h2 {
            margin-top: 4rem;
            font-size: 32px;
        }

        .article-content blockquote p {
