        max-width: 820px;
        font-size: clamp(48px, 6vw, 76px);
        line-height: 1;
        font-weight: 500;
        letter-spacing: -0.05em;
    }

    .article-intro {
        max-width: 600px;
        margin: 32px 0 0;
        font-size: 20px;
        line-height: 1.55;
        color: var(--color-muted);
    }

    .article-content {
        max-width: 680px;
        padding: 80px 0 160px;
        border-top: 1px solid rgba(36, 36, 36, 0.12);
    }

    .article-content p {
        margin: 0 0 1.5rem;
        font-size: 19px;
        line-height: 1.75;
    }

    .article-content h2 {
        max-width: 680px;
        margin: 5rem 0 1.5rem;
        font-size: clamp(30px, 4vw, 42px);
        line-height: 1.08;
        font-weight: 500;
        letter-spacing: -0.035em;
    }

    .article-content blockquote {
        margin: 2rem 0;
        padding-left: 1.5rem;
        border-left: 2px solid rgba(36, 36, 36, 0.18);
    }

    .article-content blockquote p {
        margin: 0;
        font-size: 21px;
        line-height: 1.6;
    }

