    .article-header {
        max-width: 820px;
        padding: 120px 0 100px;
    }

    .article-header h1 {
        margin: 0;
        max-width: 820px;
        font-size: clamp(48px, 6vw, 76px);
        line-height: 1;
        font-weight: 500;
        letter-spacing: -0.05em;
    }

    .article-intro {
        max-width: 600px;
        margin: 32px 0 0;
        font-size: 20px;
        line-height: 1.55;
        color: var(--color-muted);
    }

    .article-content {
        max-width: 680px;
        padding: 80px 0 160px;
        border-top: 1px solid rgba(36, 36, 36, 0.12);
    }

    .article-content p {
        margin: 0 0 1.5rem;
        font-size: 19px;
        line-height: 1.75;
    }

    .article-content h2 {
        max-width: 680px;
        margin: 5rem 0 1.5rem;
        font-size: clamp(30px, 4vw, 42px);
        line-height: 1.08;
        font-weight: 500;
        letter-spacing: -0.035em;
    }

    .article-content blockquote {
        margin: 2rem 0;
        padding-left: 1.5rem;
        border-left: 2px solid rgba(36, 36, 36, 0.18);
    }

    .article-content blockquote p {
        margin: 0;
        font-size: 21px;
        line-height: 1.6;
    }

    @media (max-width: 640px) {
        .article-page {
            width: min(100% - 32px, var(--container));
        }

        .article-header {
            padding: 72px 0 80px;
        }

        .article-header h1 {
            font-size: clamp(42px, 11vw, 58px);
        }

        .article-intro {
            font-size: 18px;
        }

        .article-content {
            padding: 56px 0 100px;
        }

        .article-content p {
            font-size: 17px;
            line-height: 1.7;
        }

        .article-content h2 {
            margin-top: 4rem;
            font-size: 32px;
        }

        .article-content blockquote p {
            font-size: 19px;
        }
    }
</style>
