---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Articles — Dating Photo Lab"
    description="Practical ideas for feeling more natural and confident in photos."
>
    <main class="articles-page">
        <section class="articles-page-intro">
            <p class="eyebrow">ARTICLES</p>

            <h1>Ideas for feeling more natural in photos.</h1>

            <p>
                Practical thoughts on photos, confidence, and telling a better
                story without trying too hard.
            </p>
        </section>

        <section class="articles-list">
            <a
                class="article-list-item"
                href="/articles/how-lighting-changes-the-way-you-look-in-photos/"
            >
                <span class="article-list-number">13</span>

                <div>
                    <h2>How Lighting Changes the Way You Look in Photos</h2>

                    <p>Photos &amp; Camera Confidence</p>
                </div>

                <span class="article-list-arrow">→</span>
            </a>

            <a
                class="article-list-item"
                href="/articles/why-some-photos-look-better-when-youre-not-trying-to-look-good/"
            >
                <span class="article-list-number">14</span>

                <div>
                    <h2>
                        Why Some Photos Look Better When You’re Not Trying to
                        Look Good
                    </h2>

                    <p>Photos &amp; Camera Confidence</p>
                </div>

                <span class="article-list-arrow">→</span>
            </a>

            <a
                class="article-list-item"
                href="/articles/why-your-first-few-photos-usually-arent-the-ones-you-like/"
            >
                <span class="article-list-number">15</span>

                <div>
                    <h2>
                        Why Your First Few Photos Usually Aren’t the Ones You
                        Like
                    </h2>

                    <p>Photos &amp; Camera Confidence</p>
                </div>

                <span class="article-list-arrow">→</span>
            </a>

            <a
                class="article-list-item"
                href="/articles/why-your-dating-profile-photos-can-feel-disconnected-even-when-theyre-all-good/"
            >
                <span class="article-list-number">16</span>
                <div>
                    <h2>
                        Why Your Dating Profile Photos Can Feel Disconnected
                        Even When They're All Good
                    </h2>
                    <p>Dating Profile Photos</p>
                </div>
                <span class="article-list-arrow">→</span>
            </a>

            <a
                class="article-list-item"
                href="/articles/why-your-best-dating-photo-isnt-always-the-best-one-to-lead-with/"
            >
                <span class="article-list-number">17</span>
                <div>
                    <h2>
                        Why Your Best Dating Photo Isn't Always the Best One to
                        Lead With
                    </h2>
                    <p>Dating Profile Photos</p>
                </div>
                <span class="article-list-arrow">→</span>
            </a>

            <a
                class="article-list-item"
                href="/articles/why-some-dating-photos-feel-more-trustworthy-than-others/"
            >
                <span class="article-list-number">18</span>
                <div>
                    <h2>
                        Why Some Dating Photos Feel More Trustworthy Than Others
                    </h2>
                    <p>Dating Profile Photos</p>
                </div>
                <span class="article-list-arrow">→</span>
            </a>

            <a
                class="article-list-item"
                href="/articles/how-camera-distance-changes-the-way-you-look-in-photos/"
            >
                <span class="article-list-number">19</span>
                <div>
                    <h2>
                        How Camera Distance Changes the Way You Look in Photos
                    </h2>
                    <p>Photos &amp; Camera Confidence</p>
                </div>
                <span class="article-list-arrow">→</span>
            </a>
        </section>

        <nav class="pagination" aria-label="Article pagination">
            <a class="pagination-previous" href="/articles/">← Previous</a>
        </nav>
    </main>
</BaseLayout>

<style>
    .articles-list {
        padding-bottom: 80px;
        border-top: 1px solid rgba(36, 36, 36, 0.12);
    }

    .article-list-item {
        display: grid;
        grid-template-columns: 64px 1fr auto;
        align-items: center;
        gap: 24px;
        padding: 32px 0;
        border-bottom: 1px solid rgba(36, 36, 36, 0.12);
        text-decoration: none;
    }

    .article-list-number {
        font-size: 12px;
        color: var(--color-muted);
    }

    .article-list-item h2 {
        margin: 0;
        max-width: 760px;
        font-size: 22px;
        font-weight: 500;
        line-height: 1.2;
        letter-spacing: -0.025em;
    }

    .article-list-item p {
        margin: 8px 0 0;
        font-size: 14px;
        color: var(--color-muted);
    }

    .article-list-arrow {
        font-size: 20px;
        transition: transform 180ms ease;
    }

    .article-list-item:hover .article-list-arrow {
        transform: translateX(4px);
    }

    .pagination {
        display: flex;
        justify-content: flex-start;
        gap: 40px;
        max-width: 680px;
        margin: 0 auto;
        padding-bottom: 160px;
    }

    .pagination a {
        text-decoration: none;
        font-size: 15px;
    }

    @media (max-width: 640px) {
        .pagination {
            padding-bottom: 100px;
        }

        .pagination a {
            display: inline-block;
            padding: 12px 0;
            font-size: 15px;
        }
    }
</style>
