            width: min(100% - 32px, var(--container));
        }

        .article-header {
            padding: 72px 0 80px;
        }

        .article-header h1 {
            font-size: clamp(42px, 11vw, 58px);
        }

        .article-intro {
            font-size: 18px;
        }

        .article-content {
            padding: 56px 0 100px;
        }

        .article-content p {
            font-size: 17px;
            line-height: 1.7;
        }

        .article-content h2 {
            margin-top: 4rem;
            font-size: 32px;
        }

        .article-content blockquote p {
            font-size: 19px;
        }
    }
