    }

    .article-intro {
        max-width: 600px;
        margin: 32px 0 0;
        font-size: 20px;
        line-height: 1.55;
        color: var(--color-muted);
    }

    .article-content {
        max-width: 680px;
        padding: 80px 0 160px;
