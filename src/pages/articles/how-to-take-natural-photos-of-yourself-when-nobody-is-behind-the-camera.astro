    }

    .article-content p {
        margin: 0 0 1.5rem;
        font-size: 19px;
        line-height: 1.75;
    }

    .article-content h2 {
        max-width: 680px;
        margin: 5rem 0 1.5rem;
        font-size: clamp(30px, 4vw, 42px);
        line-height: 1.08;
        font-weight: 500;
        letter-spacing: -0.035em;
    }

    .article-content blockquote {
        margin: 2rem 0;
        padding-left: 1.5rem;
